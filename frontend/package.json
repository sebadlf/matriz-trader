{
  "name": "matriz-trader-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "e2e": "playwright test",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:unused": "knip",
    "size": "size-limit",
    "typecheck:node": "tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "antd": "^6.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@swc/core": "^1.16.22",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "^18.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.48.0",
    "msw": "^2.15.0",
    "orval": "^8.49.0",
    "size-limit": "^14.3.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "size-limit": [
    {
      "name": "JS total (gzip)",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "240 kB"
    }
  ],
  "packageManager": "pnpm@12.23.0"
}
