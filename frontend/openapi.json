{
  "components": {
    "schemas": {
      "AccountsResponse": {
        "properties": {
          "accounts": {
            "items": {
              "type": "string"
            },
            "title": "Accounts",
            "type": "array"
          }
        },
        "required": [
          "accounts"
        ],
        "title": "AccountsResponse",
        "type": "object"
      },
      "CancelOrderRequest": {
        "properties": {
          "cl_ord_id": {
            "minLength": 1,
            "title": "Cl Ord Id",
            "type": "string"
          },
          "proprietary": {
            "minLength": 1,
            "title": "Proprietary",
            "type": "string"
          }
        },
        "required": [
          "cl_ord_id",
          "proprietary"
        ],
        "title": "CancelOrderRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstrumentOut": {
        "properties": {
          "market_id": {
            "title": "Market Id",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "market_id"
        ],
        "title": "InstrumentOut",
        "type": "object"
      },
      "NewOrderRequest": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "minLength": 1,
            "title": "Account Id",
            "type": "string"
          },
          "market_id": {
            "const": "ROFX",
            "title": "Market Id",
            "type": "string"
          },
          "order_type": {
            "enum": [
              "MARKET",
              "LIMIT"
            ],
            "title": "Order Type",
            "type": "string"
          },
          "price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "quantity": {
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          },
          "side": {
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Side",
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "symbol",
          "market_id",
          "side",
          "order_type",
          "quantity"
        ],
        "title": "NewOrderRequest",
        "type": "object"
      },
      "OrderAckOut": {
        "properties": {
          "cl_ord_id": {
            "title": "Cl Ord Id",
            "type": "string"
          },
          "proprietary": {
            "title": "Proprietary",
            "type": "string"
          }
        },
        "required": [
          "cl_ord_id",
          "proprietary"
        ],
        "title": "OrderAckOut",
        "type": "object"
      },
      "OrderOut": {
        "properties": {
          "account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "cl_ord_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cl Ord Id"
          },
          "cum_qty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cum Qty"
          },
          "leaves_qty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leaves Qty"
          },
          "market_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Id"
          },
          "ord_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ord Type"
          },
          "order_qty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Qty"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "proprietary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proprietary"
          },
          "side": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "transact_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transact Time"
          }
        },
        "required": [
          "cl_ord_id",
          "proprietary",
          "account_id",
          "symbol",
          "market_id",
          "side",
          "ord_type",
          "order_qty",
          "price",
          "cum_qty",
          "leaves_qty",
          "status",
