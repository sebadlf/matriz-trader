# Matriz Trader — configuración centralizada (AC-25, AC-26).
# Copiar a `.env` en la raíz y completar. Solo valores de ejemplo: no commitear secretos reales (AC-44).

# --- PostgreSQL (docker compose + dev) ---
POSTGRES_USER=matriz
# Debe ser URL-safe: se interpola en DATABASE_URL.
# OJO: la imagen de postgres aplica POSTGRES_USER/POSTGRES_PASSWORD solo al inicializar un volumen
# vacío. Si cambiás la contraseña con el volumen `pgdata` ya creado, el backend queda unhealthy
# ("password authentication failed"). Cómo realinear: ver "Credenciales de Postgres" en CLAUDE.md.
POSTGRES_PASSWORD=changeme
POSTGRES_DB=matriz_trader
POSTGRES_PORT=5432
# URL usada por backend/worker/alembic en modo dev (en compose se sobreescribe con host "postgres")
DATABASE_URL=postgresql+psycopg://matriz:changeme@localhost:5432/matriz_trader

# --- Backend ---
BACKEND_PORT=8000
# Orígenes CORS separados por coma (servidor dev del frontend)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_DEV_PORT=5173
# URL base de la API en dev; el build de producción usa /api (nginx)
VITE_API_BASE_URL=http://localhost:8000
# Puerto publicado por nginx en docker compose
FRONTEND_PORT=8080

# --- Matriz (backend + worker) ---
# Worker: obligatorias, sale con código 2 si falta alguna (sandbox reMarkets por defecto).
# Backend: opcionales; sin MATRIZ_USERNAME/MATRIZ_PASSWORD, /health responde igual y los
# endpoints de órdenes devuelven 503.
MATRIZ_BASE_URL=https://api.remarkets.primary.com.ar
MATRIZ_USERNAME=changeme
MATRIZ_PASSWORD=changeme
# Cuentas operables desde /orders, separadas por coma (p. ej. REM1234,REM5678). Las lee el
# backend y las expone en GET /accounts; vacío = no hay cuentas configuradas.
# Cambiarla requiere reiniciar el backend.
MATRIZ_ACCOUNTS=
WORKER_HEARTBEAT_SECONDS=30

# --- Worker / market-data-client (única fuente de market data) ---
# Obligatorias: el worker sale con código 2 si falta alguna.
# Client ID de la app Auth0 (grant client_credentials)
MARKET_DATA_CLIENT_ID=changeme
# Client secret de la app Auth0 — nunca commitear el valor real
MARKET_DATA_CLIENT_SECRET=changeme
# Audience de la API de market data en Auth0
MARKET_DATA_AUDIENCE=changeme
# Endpoint de tokens de Auth0
MARKET_DATA_AUTH0_TOKEN_URL=https://example.auth0.com/oauth/token
# Opcional: URL base de la API (default de la librería: develop)
MARKET_DATA_BASE_URL=https://market-data-develop.bbsa.com.ar/api

# --- Tests de integración ---
E2E_BASE_URL=http://localhost:8080
