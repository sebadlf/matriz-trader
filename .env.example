# =====================================================================
# matriz-trader — variables de entorno
# Copiá este archivo a `.env` en la raíz del repo: `cp .env.example .env`
# Es el ÚNICO .env del proyecto: lo leen backend, frontend y Docker Compose.
# Los valores de ejemplo NO son secretos; cambialos en tu `.env` local.
# =====================================================================

# --- PostgreSQL (lo usan los servicios db de compose) ---
# Usuario que crea la imagen de Postgres al inicializar el volumen.
POSTGRES_USER=matriz
# Contraseña de ese usuario (solo para desarrollo local; cambiala en producción).
POSTGRES_PASSWORD=change-me-local-only
# Nombre de la base de datos que se crea al inicializar el volumen.
POSTGRES_DB=matriz_trader
# Puerto del host donde compose publica Postgres.
POSTGRES_PORT=5432

# --- Backend (Settings de Pydantic) ---
# Entorno de ejecución: development | production.
APP_ENV=development
# URL de conexión SQLAlchemy (driver psycopg v3) para correr el backend localmente.
# En Docker Compose se sobreescribe para apuntar al host `db`.
DATABASE_URL=postgresql+psycopg://matriz:change-me-local-only@localhost:5432/matriz_trader
# Interfaz donde escucha uvicorn.
BACKEND_HOST=0.0.0.0
# Puerto donde escucha uvicorn (y que compose publica en el host).
BACKEND_PORT=8000
# Nivel de log de uvicorn: critical | error | warning | info | debug.
LOG_LEVEL=info

# --- matriz-client (API de Primary / Matriz) ---
# Usuario de la API de Primary. Obligatoria: el backend no arranca sin ella.
PRIMARY_USER=change-me-user
# Contraseña de ese usuario. Obligatoria y secreta: nunca la commitees.
PRIMARY_PASSWORD=change-me-local-only
# URL base de la API de Primary. Opcional; default de la librería: https://api.remarkets.primary.com.ar (sandbox reMarkets).
PRIMARY_BASE_URL=https://api.remarkets.primary.com.ar

# --- market-data-client (API de market data, autenticación con Auth0) ---
# Client ID de Auth0 para market data. Obligatoria.
MARKET_DATA_CLIENT_ID=change-me-client-id
# Client secret de Auth0. Obligatoria y secreta: nunca la commitees.
MARKET_DATA_CLIENT_SECRET=change-me-local-only
# Audience del token de Auth0. Obligatoria.
MARKET_DATA_AUDIENCE=change-me-audience
# URL absoluta del endpoint de token de Auth0. Obligatoria, sin default.
MARKET_DATA_AUTH0_TOKEN_URL=https://change-me.auth0.com/oauth/token
# URL base de la API de market data. Opcional; default de la librería: https://market-data-develop.bbsa.com.ar/api.
MARKET_DATA_BASE_URL=https://market-data-develop.bbsa.com.ar/api

# --- Frontend (vite.config.ts, sin prefijo VITE_: no llega al bundle) ---
# URL del backend a la que el dev server de Vite hace proxy de /api.
BACKEND_URL=http://localhost:8000
# Puerto del host para el dev server de Vite (compose dev).
FRONTEND_PORT=5173
# Puerto del host para nginx sirviendo el build (compose prod).
FRONTEND_PROD_PORT=8080
