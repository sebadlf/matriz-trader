# --- Entorno: un único .env en la raíz, nunca versionado ---
.env
.env.*
!.env.example

# --- Python (backend/) ---
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
